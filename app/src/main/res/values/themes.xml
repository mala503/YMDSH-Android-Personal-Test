<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeepseekHarness" parent="Theme.DSHA.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DSHA.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorPrimaryContainer">@color/raised</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <!-- 底栏选中指示 / 芯片选中底色走这两个（不给的话 Material 会自己算一个
             紫色系默认值，跟本 App 的蓝灰配色打架） -->
        <item name="colorSecondaryContainer">@color/ripple</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <!-- 表面层级：卡片=card，次级容器=raised，描边=line。
             Switch / CheckBox / Slider / AlertDialog 都吃这几个语义色，
             补齐后系统控件才会和自绘的卡片按钮同色系。 -->
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/raised</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/err</item>
        <item name="colorOnError">@color/error_on</item>
        <item name="colorControlHighlight">@color/ripple</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- 弹窗圆角/配色跟随 App（系统默认弹窗是直角 + 紫色按钮）。
             两条各管一路：alertDialogTheme 管 appcompat/framework 的 AlertDialog，
             materialAlertDialogTheme 管 MaterialAlertDialogBuilder。 -->
        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material</item>

        <!-- 关闭自动着色时必须同时指定默认背景和文字状态，否则未指定背景的按钮会变黑。 -->
        <item name="materialButtonStyle">@style/Widget.DSHA.Button</item>
        <item name="buttonStyle">@style/Widget.DSHA.Button</item>
        <item name="android:buttonStyle">@style/Widget.DSHA.PlatformButton</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="radioButtonStyle">@style/Widget.DSHA.RadioButton</item>
        <item name="checkboxStyle">@style/Widget.DSHA.CheckBox</item>
        <item name="materialSwitchStyle">@style/Widget.DSHA.Switch</item>
    </style>

    <!-- 两套独立绘制的白色 Material3 配色；全局语义色由 Activity 主题选择。 -->
    <style name="Theme.DSHA.Paper" parent="Theme.DeepseekHarness">
        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert.Paper</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material.Paper</item>
        <item name="colorPrimary">@color/ym_paper_primary</item>
        <item name="colorOnPrimary">@color/ym_paper_on_primary</item>
        <item name="colorPrimaryContainer">@color/ym_paper_raised</item>
        <item name="colorOnPrimaryContainer">@color/ym_paper_primary</item>
        <item name="colorSecondary">@color/ym_paper_secondary</item>
        <item name="colorSecondaryContainer">@color/ym_paper_select</item>
        <item name="colorOnSecondaryContainer">@color/ym_paper_primary</item>
        <item name="colorSurface">@color/ym_paper_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_paper_surface</item>
        <item name="colorSurfaceContainerLow">@color/ym_paper_card</item>
        <item name="colorSurfaceContainer">@color/ym_paper_card</item>
        <item name="colorSurfaceContainerHigh">@color/ym_paper_raised</item>
        <item name="colorSurfaceContainerHighest">@color/ym_paper_raised</item>
        <item name="colorOnSurface">@color/ym_paper_text</item>
        <item name="colorOnSurfaceVariant">@color/ym_paper_muted</item>
        <item name="colorOutline">@color/ym_paper_line</item>
        <item name="colorOutlineVariant">@color/ym_paper_line</item>
        <item name="android:colorBackground">@color/ym_paper_surface</item>
        <item name="android:windowBackground">@color/ym_paper_surface</item>
        <item name="android:navigationBarColor">@color/ym_paper_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ym_paper_primary</item>
        <item name="colorControlActivated">@color/ym_paper_primary</item>
    </style>
    <style name="Theme.DSHA.Porcelain" parent="Theme.DeepseekHarness">
        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert.Porcelain</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material.Porcelain</item>
        <item name="colorPrimary">@color/ym_porcelain_primary</item>
        <item name="colorOnPrimary">@color/ym_porcelain_on_primary</item>
        <item name="colorPrimaryContainer">@color/ym_porcelain_raised</item>
        <item name="colorOnPrimaryContainer">@color/ym_porcelain_primary</item>
        <item name="colorSecondary">@color/ym_porcelain_secondary</item>
        <item name="colorSecondaryContainer">@color/ym_porcelain_select</item>
        <item name="colorOnSecondaryContainer">@color/ym_porcelain_primary</item>
        <item name="colorSurface">@color/ym_porcelain_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_porcelain_surface</item>
        <item name="colorSurfaceContainerLow">@color/ym_porcelain_card</item>
        <item name="colorSurfaceContainer">@color/ym_porcelain_card</item>
        <item name="colorSurfaceContainerHigh">@color/ym_porcelain_raised</item>
        <item name="colorSurfaceContainerHighest">@color/ym_porcelain_raised</item>
        <item name="colorOnSurface">@color/ym_porcelain_text</item>
        <item name="colorOnSurfaceVariant">@color/ym_porcelain_muted</item>
        <item name="colorOutline">@color/ym_porcelain_line</item>
        <item name="colorOutlineVariant">@color/ym_porcelain_line</item>
        <item name="android:colorBackground">@color/ym_porcelain_surface</item>
        <item name="android:windowBackground">@color/ym_porcelain_surface</item>
        <item name="android:navigationBarColor">@color/ym_porcelain_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ym_porcelain_primary</item>
        <item name="colorControlActivated">@color/ym_porcelain_primary</item>
    </style>

    <style name="Theme.DSHA.Claude" parent="Theme.DeepseekHarness">
        <item name="alertDialogTheme">@style/Dialog.DSHA.Alert.Claude</item>
        <item name="materialAlertDialogTheme">@style/Dialog.DSHA.Material.Claude</item>
        <item name="colorPrimary">@color/ym_claude_primary</item>
        <item name="colorOnPrimary">@color/ym_claude_on_primary</item>
        <item name="colorPrimaryContainer">@color/ym_claude_raised</item>
        <item name="colorOnPrimaryContainer">@color/ym_claude_primary</item>
        <item name="colorSecondary">@color/ym_claude_secondary</item>
        <item name="colorSecondaryContainer">@color/ym_claude_select</item>
        <item name="colorOnSecondaryContainer">@color/ym_claude_primary</item>
        <item name="colorSurface">@color/ym_claude_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_claude_surface</item>
        <item name="colorSurfaceContainerLow">@color/ym_claude_card</item>
        <item name="colorSurfaceContainer">@color/ym_claude_card</item>
        <item name="colorSurfaceContainerHigh">@color/ym_claude_raised</item>
        <item name="colorSurfaceContainerHighest">@color/ym_claude_raised</item>
        <item name="colorOnSurface">@color/ym_claude_text</item>
        <item name="colorOnSurfaceVariant">@color/ym_claude_muted</item>
        <item name="colorOutline">@color/ym_claude_line</item>
        <item name="colorOutlineVariant">@color/ym_claude_line</item>
        <item name="android:colorBackground">@color/ym_claude_surface</item>
        <item name="android:windowBackground">@color/ym_claude_surface</item>
        <item name="android:navigationBarColor">@color/ym_claude_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ym_claude_primary</item>
        <item name="colorControlActivated">@color/ym_claude_primary</item>
    </style>

    <!-- appcompat / framework AlertDialog：必须是完整 Dialog 主题（不能给 Overlay） -->
    <style name="Dialog.DSHA.Alert" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/raised</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="shapeAppearanceOverlay">@style/Shape.DSHA.Dialog</item>
    </style>

    <!-- MaterialAlertDialogBuilder 专用（必须是 ThemeOverlay） -->
    <style name="Dialog.DSHA.Material" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:backgroundDimAmount">0.22</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DSHA.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DSHA.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DSHA.DialogButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.DSHA.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.DSHA.DialogBody</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/raised</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="shapeAppearanceOverlay">@style/Shape.DSHA.Dialog</item>
    </style>

    <!-- 原生 AlertDialog 和 MaterialAlertDialog 使用同一套主题语义色，避免
         Claude 暖杏外观在弹窗里突然回到默认蓝色。 -->
    <style name="Dialog.DSHA.Alert.Paper" parent="Dialog.DSHA.Alert">
        <item name="colorPrimary">@color/ym_paper_primary</item>
        <item name="android:colorAccent">@color/ym_paper_primary</item>
        <item name="colorSurface">@color/ym_paper_card</item>
        <item name="colorOnSurface">@color/ym_paper_text</item>
        <item name="android:textColorPrimary">@color/ym_paper_text</item>
        <item name="android:textColorSecondary">@color/ym_paper_muted</item>
    </style>
    <style name="Dialog.DSHA.Alert.Porcelain" parent="Dialog.DSHA.Alert">
        <item name="colorPrimary">@color/ym_porcelain_primary</item>
        <item name="android:colorAccent">@color/ym_porcelain_primary</item>
        <item name="colorSurface">@color/ym_porcelain_card</item>
        <item name="colorOnSurface">@color/ym_porcelain_text</item>
        <item name="android:textColorPrimary">@color/ym_porcelain_text</item>
        <item name="android:textColorSecondary">@color/ym_porcelain_muted</item>
    </style>
    <style name="Dialog.DSHA.Alert.Claude" parent="Dialog.DSHA.Alert">
        <item name="colorPrimary">@color/ym_claude_primary</item>
        <item name="android:colorAccent">@color/ym_claude_primary</item>
        <item name="colorSurface">@color/ym_claude_card</item>
        <item name="colorOnSurface">@color/ym_claude_text</item>
        <item name="android:textColorPrimary">@color/ym_claude_text</item>
        <item name="android:textColorSecondary">@color/ym_claude_muted</item>
    </style>

    <style name="Dialog.DSHA.Material.Paper" parent="Dialog.DSHA.Material">
        <item name="colorPrimary">@color/ym_paper_primary</item>
        <item name="android:colorAccent">@color/ym_paper_primary</item>
        <item name="colorSurface">@color/ym_paper_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_paper_surface</item>
        <item name="colorSurfaceContainerHighest">@color/ym_paper_raised</item>
        <item name="colorOnSurface">@color/ym_paper_text</item>
        <item name="android:textColorHint">@color/ym_paper_muted</item>
    </style>
    <style name="Dialog.DSHA.Material.Porcelain" parent="Dialog.DSHA.Material">
        <item name="colorPrimary">@color/ym_porcelain_primary</item>
        <item name="android:colorAccent">@color/ym_porcelain_primary</item>
        <item name="colorSurface">@color/ym_porcelain_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_porcelain_surface</item>
        <item name="colorSurfaceContainerHighest">@color/ym_porcelain_raised</item>
        <item name="colorOnSurface">@color/ym_porcelain_text</item>
        <item name="android:textColorHint">@color/ym_porcelain_muted</item>
    </style>
    <style name="Dialog.DSHA.Material.Claude" parent="Dialog.DSHA.Material">
        <item name="colorPrimary">@color/ym_claude_primary</item>
        <item name="android:colorAccent">@color/ym_claude_primary</item>
        <item name="colorSurface">@color/ym_claude_card</item>
        <item name="colorSurfaceContainerLowest">@color/ym_claude_surface</item>
        <item name="colorSurfaceContainerHighest">@color/ym_claude_raised</item>
        <item name="colorOnSurface">@color/ym_claude_text</item>
        <item name="android:textColorHint">@color/ym_claude_muted</item>
    </style>

    <style name="Shape.DSHA.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
