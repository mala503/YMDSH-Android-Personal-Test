<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/colorSurfaceContainerLowest">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:paddingBottom="22dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="偏好与设备" android:textSize="29sp" android:textColor="?attr/colorOnSurface" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="14dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_settings_hint" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="6dp" />
    <LinearLayout android:id="@+id/settings_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:padding="17dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/ymdsh_feature_card" android:clickable="true" android:focusable="true">
      <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_ym_palette" android:padding="10dp" android:background="@drawable/ymdsh_soft_chip" android:contentDescription="@null"/>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择白色主题" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="素纸 / 瓷白  ·  两款专属设计" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="5dp"/>
      </LinearLayout>
      <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_ui2_chevron" app:tint="?attr/colorOnSurfaceVariant" android:contentDescription="@null"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_workspace" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_tabs" android:orientation="vertical" android:background="@drawable/bg_card" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_experience" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_power" android:orientation="vertical" />
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_appearance" android:orientation="horizontal" android:minHeight="64dp" android:padding="13dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_language" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_language_title" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_language" android:text="" android:textSize="12sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ui2_chevron" android:contentDescription="@null" app:tint="@color/text_muted" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_overlay" android:orientation="horizontal" android:minHeight="64dp" android:padding="13dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_chat" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_overlay" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_overlay_sub" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ui2_chevron" android:contentDescription="@null" app:tint="@color/text_muted" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_support" android:textSize="11sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_selftest" android:orientation="horizontal" android:minHeight="64dp" android:padding="13dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_shield" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_diagnostics" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_diagnostics_sub" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ui2_chevron" android:contentDescription="@null" app:tint="@color/text_muted" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_about" android:orientation="horizontal" android:minHeight="64dp" android:padding="13dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_about" android:background="@drawable/bg_logo" android:padding="8dp" android:contentDescription="@null" app:tint="@color/primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_about" android:textSize="13sp" android:textColor="@color/text" android:includeFontPadding="false" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui2_about_sub" android:textSize="11sp" android:textColor="@color/text_secondary" android:includeFontPadding="false" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_ui2_chevron" android:contentDescription="@null" app:tint="@color/text_muted" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/settings_ver" android:text="" android:textSize="12sp" android:textColor="@color/text_muted" android:includeFontPadding="false" android:gravity="center" android:layout_marginTop="16dp" />
  </LinearLayout>
</ScrollView>
